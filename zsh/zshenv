#!/usr/bin/env zsh

# echo "Running zshenv"

# zshenv runs for interactive and non-interactive shells
# making it ideal for variables and functions required for
# both scripts and terminal sessions.
# However, these should be kept light, since this file will run
# on every script.

# Check if a command exists
function exists() {
  # `command -v` is an alternative to the which command
  # see: https://stackoverflow.com/a/677212/1341838
  command -v "$1" 1>/dev/null 2>/dev/null
}

# Outputs all path variables, with each on a new line
alias trail='<<<${(F)path}'

# CLI tool dirs, so non-interactive shells (scripts, Hammerspoon, launchd
# agents) resolve the same tools a terminal does. Interactive PATH ordering
# is still owned by zshrc, which rebuilds PATH from scratch.
export PATH="$HOME/Library/pnpm/bin:$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:$PATH"

export CLAUDE_AUTH_PERSONAL="$HOME/.claude-auth-personal"
export CLAUDE_AUTH_WORK=""
export CLAUDE_SECURESTORAGE_CONFIG_DIR="$CLAUDE_AUTH_WORK"

