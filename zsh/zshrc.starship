#!/bin/zsh

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

HOMEBREW_PREFIX="/opt/homebrew"

# 1Password SSH Agent
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

if [[ -n $HERDR_SHELL_EXEC ]]; then
  _herdr_shell_exec=$HERDR_SHELL_EXEC
  unset HERDR_SHELL_EXEC
  exec ${=_herdr_shell_exec}
fi

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history hist_expire_dups_first hist_ignore_dups hist_ignore_space
setopt hist_verify share_history
# fcntl(2) locks: the default symlink-lock protocol sleeps 1s-per-retry (up to
# ~10s) when a killed shell leaves a stale ~/.zsh_history.LOCK.
setopt HIST_FCNTL_LOCK
setopt auto_cd auto_pushd pushd_ignore_dups pushdminus
setopt multios long_list_jobs interactivecomments prompt_subst
setopt auto_menu complete_in_word always_to_end
unsetopt menu_complete flowcontrol

# Rebuild PATH from scratch, keeping only the inherited dirs that nothing below
# re-adds: kitty's bundle (`kitten`), nix (/etc/zshrc), and Rex's `rex` CLI
# (https://www.superlogical.com/rex/docs/automate/cli#path).
_inherited_path=($path)
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
path+=(${(M)_inherited_path:#(/Applications/kitty.app/Contents/MacOS|$HOME/.nix-profile/bin|/nix/var/nix/profiles/default/bin)})
unset _inherited_path
[[ -n $REX_BIN_DIR ]] && path=($REX_BIN_DIR $path)

# Static equivalent of `brew shellenv`.
export HOMEBREW_PREFIX HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar" HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX"
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
typeset -U path

export KUBE_CONFIG_PATH="$HOME/.kube/config"

PATH=$PATH:~/.local/bin

source ~/dev/pattobrien/dotfiles/zsh/flutter.zsh
source ~/dev/pattobrien/dotfiles/zsh/go.zsh

export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export PATH="$HOME/.maestro-runner/bin:$PATH"

export MISE_TRUSTED_CONFIG_PATHS="$HOME/.dotfiles__worktrees:$HOME/dev/pattobrien"
export MISE_ACTIVATE_AGGRESSIVE=1
export MISE_GITHUB_CREDENTIAL_COMMAND="gh auth token"
# No `mise activate`: tools resolve through the shims dir instead. Each shim
# call costs 60-90ms, so shims go last and any real tool dir above wins.
export PATH="$PATH:$XDG_DATA_HOME/mise/shims"

# fzf: Catppuccin Mocha theme (matches kitty theme)
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
--color=selected-bg:#45475a \
--color=border:#6C7086,label:#CDD6F4"

export EDITOR='nvim'

alias ls='ls -G'
alias grep='grep --color=auto'

# Tool init scripts are sourced from a cache and regenerated whenever the tool's
# binary or this file is newer than the cache.
_zsh_cache_dir="$XDG_CACHE_HOME/zsh"
_zshrc_file="${${(%):-%x}:A}"
cached-init() {
  local cache="$_zsh_cache_dir/$1.zsh" bin
  [[ $2 == */* ]] && bin="${2:A}" || bin="${commands[$2]:A}"
  shift 2
  if [[ ! -s $cache || $bin -nt $cache || $_zshrc_file -nt $cache ]]; then
    mkdir -p "$_zsh_cache_dir"
    "$@" >| "$cache"
  fi
  source "$cache"
}

# Prompt: ~/.config/starship.toml (linked from zsh/starship.toml).
# `starship init` embeds whichever `starship` PATH resolves to, so the real
# binary dir goes ahead of the mise shims or every prompt pays the shim cost.
path=("$XDG_DATA_HOME/mise/installs/starship/latest" $path)
cached-init starship_init starship starship init zsh --print-full-init

# Completions: Homebrew and mise-installed tools' functions, loaded from a dump
# that is only rebuilt when this file changes (`compinit -C` skips the per-start
# fpath scan). Delete the dump to pick up newly installed completion files.
fpath=("$XDG_DATA_HOME/mise-completions/zsh" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
_zcompdump="$_zsh_cache_dir/zcompdump-starship"
[[ $_zshrc_file -nt $_zcompdump ]] && rm -f "$_zcompdump"
autoload -Uz compinit
compinit -C -d "$_zcompdump"
unset _zcompdump

# shed completions (`shed --completion` costs ~140ms per startup), generated by
# the global binary: inside a shed worktree, `shed` resolves to the checkout's
# source, which fails until that worktree's install finishes
_shed_bin="$PNPM_HOME/bin/shed"
cached-init shed_completions $_shed_bin $_shed_bin --completion
unset _shed_bin

source ~/dev/pattobrien/dotfiles/zsh/completion-for-workmux.zsh

source ~/dev/pattobrien/dotfiles/zsh/python.zsh
source ~/dev/pattobrien/dotfiles/zsh/credentials.zsh
source ~/dev/pattobrien/dotfiles/zsh/aliases.zsh

if [ -f ~/dev/pattobrien/dotfiles/zsh/.env.zsh ]; then
  source ~/dev/pattobrien/dotfiles/zsh/.env.zsh
fi

bindkey -v # set up vim motions in interactive terminal

bindkey -M viins '^[^?' backward-kill-word
bindkey -M viins '^[[3;3~' kill-line

# fzf key bindings and completion, then Television takes over Ctrl+T (smart
# autocomplete) and Ctrl+R (history); fzf keeps Alt+C cd and `**<Tab>`. Both
# must come after `bindkey -v` or the keymap switch drops the bindings.
cached-init fzf_init fzf fzf --zsh
cached-init tv_init tv tv init zsh

# zoxide: `z`/`zi` frecency cd. Feeds herdr-navigator and the tv zoxide channel.
cached-init zoxide_init zoxide zoxide init zsh

cached-init wt_init wt command wt config shell init zsh

# herdr-automatic-rename: rename the tab the instant a command starts
for _f in ${HOME}/.config/herdr/plugins/github/herdr-automatic-rename-*/shell/hook.zsh(N); do
  source $_f; break
done

# Cmd+K (via Ghostty F12 escape sequence): clear screen + scrollback when not in tmux
# Inside tmux this is handled by tmux's F12 binding in .tmux.conf
if [[ -z "$TMUX" ]]; then
  function _clear-screen-and-scrollback() {
    clear && printf '\e[3J'
    zle reset-prompt
  }
  zle -N _clear-screen-and-scrollback
  bindkey '\e[24~' _clear-screen-and-scrollback
fi

# Plugins: antidote static bundle, rebuilt when zsh_plugins.txt changes.
# Bind autosuggest widgets once instead of rebinding every widget on every
# precmd (6-16ms per prompt). All widgets here are defined before the first prompt.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
_zsh_plugins_bundle="$XDG_CACHE_HOME/zsh/zsh_plugins.zsh"
if [[ ! $_zsh_plugins_bundle -nt ~/dev/pattobrien/dotfiles/zsh/zsh_plugins.txt ]]; then
  mkdir -p "${_zsh_plugins_bundle:h}"
  source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
  antidote bundle <~/dev/pattobrien/dotfiles/zsh/zsh_plugins.txt >| "$_zsh_plugins_bundle"
fi
source "$_zsh_plugins_bundle"
unset _zsh_plugins_bundle

export LINEAR_ISSUE_SORT="priority"
export LINEAR_VCS="git"
export LINEAR_WORKSPACE="finedesigns"
# repo .env files hold op:// references, which the CLI would read as the API key
export LINEAR_IGNORE_ENV_FILE=1

# Vite+ completions and the `vp` function (compdef is available now). The env
# file also prepends its node/pnpm shims, so it runs on a local one-entry PATH
# that is discarded; `vp` itself comes from mise.
() { local PATH=$HOME/.vite-plus/bin; . "$HOME/.vite-plus/env" }
