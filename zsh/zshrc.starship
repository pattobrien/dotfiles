export XDG_CONFIG_HOME=~/.config
export XDG_CACHE_HOME=~/.cache
export XDG_DATA_HOME=~/.local/share
export XDG_STATE_HOME=~/.local/state

if [[ -n $HERDR_SHELL_EXEC ]]; then
  _cmd=$HERDR_SHELL_EXEC; unset HERDR_SHELL_EXEC; exec ${=_cmd}
fi

HISTFILE=~/.zsh_history HISTSIZE=50000 SAVEHIST=10000
setopt extended_history hist_ignore_dups hist_ignore_space share_history hist_fcntl_lock
setopt auto_cd interactivecomments combining_chars
export EDITOR=nvim
export FZF_DEFAULT_OPTS_FILE=~/.config/fzf/fzfrc

# Tool init output is cached until this file changes; mise's postinstall hook
# clears the cache after upgrades.
cached() {
  local f=~/.cache/zsh/$1.zsh; shift
  [[ $f -nt ~/.zshrc ]] || { mkdir -p ${f:h}; "$@" >| $f }
  source $f
}

# starship init embeds whichever `starship` is on PATH; the real binary avoids
# the mise shim's 60-90ms on every prompt.
path=(~/.local/share/mise/installs/starship/latest $path)
cached starship starship init zsh --print-full-init

fpath=(~/.local/share/mise-completions/zsh /opt/homebrew/share/zsh/site-functions $fpath)
autoload -Uz compinit; compinit -C -d ~/.cache/zsh/zcompdump
cached shed ~/.local/share/pnpm/bin/shed --completion
# vp completions; the env file's PATH edits stay local to the function
() { local PATH=~/.vite-plus/bin; . ~/.vite-plus/env }
source ~/dev/pattobrien/dotfiles/zsh/aliases.zsh

bindkey -v
bindkey -M viins '^[^?' backward-kill-word '^[[3;3~' kill-line
bindkey -M viins '^[[3~' delete-char '^[[H' beginning-of-line '^[[F' end-of-line
bindkey -M viins '^[OA' up-line-or-search '^[OB' down-line-or-search

cached fzf fzf --zsh
cached tv tv init zsh
cached zoxide zoxide init zsh
cached wt wt config shell init zsh
source ~/.config/herdr/plugins/github/herdr-automatic-rename-*/shell/hook.zsh

# Cmd+K: kitty.conf sends F12
clear-scrollback() { clear; printf '\e[3J'; zle reset-prompt }
zle -N clear-scrollback
bindkey '\e[24~' clear-scrollback

ZSH_AUTOSUGGEST_MANUAL_REBIND=1
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
antidote load ~/dev/pattobrien/dotfiles/zsh/zsh_plugins.txt ~/.cache/zsh/zsh_plugins.zsh
