      {
        "name": "Browse",
        "layout": "auto",
        "windows": [
          { "app": "com.google.Chrome", "appName": "Google Chrome" }
        ]
      },
      {
        "name": "Explore",
        "layout": "focus",
        "windows": [
          { "app": "net.kovidgoyal.kitty", "appName": "kitty" },
          { "app": "com.google.Chrome", "appName": "Google Chrome" }
        ]
      },
      {
        "name": "Code",
        "layout": "columns",
        "windows": [
          { "app": "net.kovidgoyal.kitty", "appName": "kitty" },
          { "app": "net.kovidgoyal.kitty", "appName": "kitty" }
        ]
      },
      {
        "name": "Triage",
        "layout": "focus",
        "windows": [
          { "app": "net.kovidgoyal.kitty", "appName": "kitty" },
          { "app": "com.linear", "appName": "Linear" }
        ]
      }
    ],
    "commands": {}
  },
  "clipboard": {
    "enabled": true,
    "retentionDays": "forever",
    "defaultAction": "paste",
    "disabledApps": [
      "com.apple.keychainaccess",
      "com.apple.Passwords",
      "com.1password.1password"
    ],
    "commands": {
      "clipboard-history": {
        "shortcut": "shift+cmd+v",
        "alias": null,
