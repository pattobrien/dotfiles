{
  "general": {
    "launcherShortcut": "option+space",
    "showInMenuBar": true,
    "automaticallyCheckForUpdates": false,
    "popToRootSeconds": 90,
    "escapeKeyBehavior": "navigateBackOrClose",
    "autoSwitchInputSource": null,
    "supportReminders": true
  },
  "appearance": {
    "theme": "dark",
    "interfaceSize": "micro",
    "overrides": {
      "radius.keyCap": 3,
      "size.panelHeight": 506,
      "size.bottomBarHeight": 32,
      "size.barButtonHeight": 20,
      "size.menuButton": 22,
      "typography.rowTrailing": 11,
      "typography.keyCap": 11,
      "typography.compactKeyCap": 11,
      "typography.bar": 11
    },
    "compactMode": true,
    "showFavoritesInCompactMode": true,
    "followCursorAcrossDisplays": true,
    "dragToReposition": true
  },
  "hyperKey": {
    "key": "none",
    "includesShift": true,
    "quickPress": "none",
    "secureInputCompatibility": false
  },
  "calculator": {
    "numberStyle": "system"
  },
  "search": {
    "showsSuggestions": true,
    "sensitivity": "medium"
  },
  "applications": {
    "enabled": true,
    "searchScopes": [
      "/Applications",
      "/Applications/Utilities",
      "/System/Applications",
      "/System/Applications/Utilities",
      "/System/Library/CoreServices/Applications",
      "/System/Volumes/Preboot/Cryptexes/App/System/Applications",
      "/System/Library/CoreServices/Finder.app",
      "~/Applications"
    ],
    "apps": {}
  },
  "systemSettings": {
    "enabled": true,
    "panes": {}
  },
  "systemActions": {
    "enabled": true,
    "actions": {}
  },
  "commands": {
    "builtInEnabled": true,
    "builtIn": {},
    "enabled": false,
    "showInLauncher": true
  },
  "quicklinks": {
    "enabled": true,
    "showInLauncher": true,
    "opensNewWindow": false,
    "passesSelectedText": false,
    "confirmsBeforeDelete": true,
    "commands": {}
  },
  "appleShortcuts": {
    "enabled": true
  },
  "ai": {
    "enabled": true,
    "webSearch": false,
    "systemPrompt": "",
    "systemPromptEnabled": true,
    "retentionDays": "forever",
    "opensTo": "recent",
    "newChatAfterMinutes": 5,
    "toolRounds": 25,
    "commands": {}
  },
  "quickActions": {
    "targetLanguage": "",
    "commands": {}
  },
  "dictation": {
    "mode": "toggle",
    "shortcut": null,
    "model": "redux",
    "microphone": null,
    "destination": "paste",
    "adaptsCapitalization": true,
    "liveInsertion": false,
    "releaseAfterMinutes": 1,
    "language": null
  },
  "fileSearch": {
    "enabled": true,
    "scopes": [
      "~/dev",
      "~/Documents",
      "~/Downloads",
      "~/Desktop"
    ],
    "ignorePatterns": [
      ".git",
      ".turbo",
      ".next",
      ".worktrees"
    ],
    "commands": {}
  },
  "notes": {
    "enabled": true,
    "rendersMarkdown": true,
    "showsFormattingBar": true,
    "folder": "~/dev/pattobrien/notes/inbox",
    "commands": {}
  },
  "snippets": {
    "showInLauncher": true,
    "folder": null,
    "commands": {}
