# herdr-focus-notify configuration
# Terminal app to activate when a notification is clicked; also lets the
# plugin skip notifications when the matching pane is already visible.
HERDR_FOCUS_NOTIFY_ACTIVATE_APP=kitty

# Only notify when an agent needs input (approval/question); skip `done`
# completions — those still surface via herdr's in-app toasts and sounds.
HERDR_FOCUS_NOTIFY_STATUSES=blocked

# Note on sender identity: notifications show as "Terminal" because alerter
# defaults to --sender com.apple.Terminal and the plugin has no sender setting.
# Impersonating kitty (--sender net.kovidgoyal.kitty) does NOT work even though
# kitty is authorized for notifications: macOS pins each bundle-id's
# Notification Center registration to the registering app's code-signing
# requirement (kitty's record requires team NTY7FVCEKP), so usernoted silently
# drops alerter's spoofed posts and alerter hangs. The Terminal identity works
# only because alerter created that record itself. Verified 2026-07-27.
