# General defaults
Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 60

# garden's docker context (ssh://root@178.156.155.230): alchemy dials docker
# ~30 times in parallel, past sshd's MaxStartups, so the dials share one session
Host garden 178.156.155.230
    HostName 178.156.155.230
    User root
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m

