{
  "npmCommand": [
    "mise",
    "exec",
    "node@24",
    "--",
    "npm"
  ],
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "theme": "system",
  "enableSkillCommands": true,
  "packages": [
    "npm:pi-claude-code-ui",
    "npm:@zigai/pi-ui-tweaks",
    "npm:@zichuanlan/pi-image-placeholder",
    "https://github.com/earendil-works/pi-claude-code",
    "npm:pi-vim-editor"
  ],
  "toolBackground": "border",
  "readOutputMode": "summary",
  "searchOutputMode": "count",
  "mcpOutputMode": "summary",
  "bashOutputMode": "summary",
  "previewLines": 1,
  "bashCollapsedLines": 1,
  "liveToolPreviewLines": 1,
  "groupToolCalls": true,
  "quietStartup": true,
  "vimEditor": {
    "clipboard": "unnamedplus"
  }
}