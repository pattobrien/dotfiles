{
  "$schema": "https://opencode.ai/config.json",
  "username": "Patt O'Brien",
  "model": "openai/gpt-5.6-sol",
  "shell": "/bin/zsh",
  "autoupdate": true,
  "share": "manual",
  "snapshot": true,
  "agent": {
    "build": {
      "variant": "xhigh",
    },
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "npm *": "deny",
      "npx *": "deny",
      "pnpm* add *": "ask",
      "brew install *": "ask",
    },
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
  },
  "compaction": {
    "auto": true,
  },
}
