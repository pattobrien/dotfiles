
.DS_Store
.pnpm-store

# **/Brewfile.lock.json
.archive/**/*
.env*
# herdr-focus-notify's .env is behavior config (no secrets), keep it synced
!.config/herdr/plugins/config/herdr-focus-notify/.env
# herdr-navigator runtime state (update-check timestamp, jump-back target), not config
.config/herdr/plugins/config/herdr-navigator/update-check
.config/herdr/plugins/config/herdr-navigator/jump-back-workspace
# herdr-lazy runtime state (bootstrap marker), not config
.config/herdr/plugins/config/herdr-lazy/bootstrapped
.vscode/**/*
.dart_tool/**/*
!.config
claude/**/*.local.*
.claude/worktrees/

# Build artifacts
node_modules
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
