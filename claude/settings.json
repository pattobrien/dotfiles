{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_CFC": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1",
    "EDITOR": "nvim",
    "ENABLE_LSP_TOOL": "0",
    "FORCE_HYPERLINK": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otlp.finedesigns.io",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_ASSISTANT_RESPONSES": "1",
    "OTEL_LOG_TOOL_CONTENT": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pnpm* build*)",
      "Bash(pnpm* format*)",
      "Bash(pnpm* install)",
      "Bash(pnpm* knip*)",
      "Bash(pnpm* lint*)",
      "Bash(pnpm* list*)",
      "Bash(pnpm* outdated*)",
      "Bash(pnpm* remove*)",
      "Bash(pnpm* run*)",
      "Bash(pnpm* start*)",
      "Bash(pnpm* typecheck*)",
      "Bash(pnpm* test*)",
      "Bash(pnpm* validate*)",
      "Bash(pnpm* view*)",
      "Bash(pnpm* why*)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(bat *)",
      "Bash(cat *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(for *)",
      "Bash(fzf *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(yq *)",
      "Bash(brew *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git status *)",
      "Bash(git worktree *)",
      "Bash(git diff-branch *)",
      "Bash(git diff-commit *)",
      "Bash(git diff-files *)",
      "Bash(git diff-index *)",
      "Bash(git diff-tag *)",
      "Bash(git diff-remote *)",
      "Bash(git diff-stash *)",
      "Bash(git diff-tree *)",
      "Bash(git diff-worktree *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh list *)",
      "Bash(gh pr *)",
      "Bash(gh release *)",
      "Bash(gh view *)",
      "Bash(docker *)",
      "Bash(linear issue *)",
      "Bash(defaults read *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:unpkg.com)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(nsc create *)",
      "Bash(nsc cluster create *)",
      "mcp__ide__getDiagnostics",
      "Artifact"
    ],
    "ask": [
      "Bash(brew install *)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~"
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "railpack": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
