    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "figma-diff": "off",
    "jsonforms-control": "off",
    "workmux": "off",
    "worktree": "off",
    "coordinator": "off",
    "merge": "off",
    "open-pr": "off",
    "terminal-use": "off",
    "caveman": "off",
    "inngest-agent-evals": "name-only",
    "inngest-agents": "name-only",
    "inngest-api": "name-only",
    "inngest-api-cli": "name-only",
    "inngest-brownfield-audit": "name-only",
    "inngest-cli": "name-only",
    "inngest-durable-functions": "name-only",
    "inngest-events": "name-only",
    "inngest-flow-control": "name-only",
    "inngest-middleware": "name-only",
    "inngest-realtime": "name-only",
    "inngest-setup": "name-only",
    "inngest-steps": "name-only",
    "inngest-v3-v4-migration": "name-only",
    "mastra": "name-only",
    "mastra-factory": "name-only",
    "chat-sdk": "name-only",
    "axe": "name-only",
    "microsandbox": "name-only",
    "opentui": "name-only",
    "effect-ts": "name-only",
    "remotion-best-practices": "name-only",
    "tailscale": "name-only",
    "typesafe-ai": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/patt/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/patt/.local/share/mise/installs/atuin/latest/atuin-aarch64-apple-darwin/atuin hook claude-code"
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__computer-use__.*|mcp__remote-devices__.*|mcp__claude-in-chrome__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/patt/.local/share/mise/installs/bun/latest/bin/bun /Users/patt/.local/bin/computer-use-guard",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/patt/.local/share/mise/installs/atuin/latest/atuin-aarch64-apple-darwin/atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/patt/.local/share/mise/installs/atuin/latest/atuin-aarch64-apple-darwin/atuin hook claude-code"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "bashEditDiffEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'input=$(cat); model=$(echo \"$input\" | jq -r \".model.display_name\"); total_in=$(echo \"$input\" | jq -r \".context_window.total_input_tokens\"); total_out=$(echo \"$input\" | jq -r \".context_window.total_output_tokens\"); total=$((total_in + total_out)); if [ $total -ge 1000000 ]; then tokens=$(printf \"%.1fM\" $(echo \"scale=1; $total / 1000000\" | bc)); elif [ $total -ge 1000 ]; then tokens=$(printf \"%.1fK\" $(echo \"scale=1; $total / 1000\" | bc)); else tokens=\"$total\"; fi; usage=$(echo \"$input\" | jq \".context_window.current_usage\"); if [ \"$usage\" != \"null\" ]; then current=$(echo \"$usage\" | jq \".input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens\"); size=$(echo \"$input\" | jq \".context_window.context_window_size\"); pct=$((current * 100 / size)); context=\"${pct}%\"; else context=\"0%\"; fi; printf \"\\033[36m%s\\033[0m | \\033[33m%s tokens\\033[0m | \\033[35m%s context\\033[0m\" \"$model\" \"$tokens\" \"$context\"'"
  },
