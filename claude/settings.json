{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_CFC": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "DISABLE_AUTOUPDATER": "1",
    "EDITOR": "nvim",
    "ENABLE_LSP_TOOL": "0",
    "FORCE_HYPERLINK": "1",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://garden:4317",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_LOG_ASSISTANT_RESPONSES": "1",
    "OTEL_LOG_TOOL_CONTENT": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(pnpm* build*)",
      "Bash(pnpm* format*)",
      "Bash(pnpm* install)",
      "Bash(pnpm* knip*)",
      "Bash(pnpm* lint*)",
      "Bash(pnpm* list*)",
      "Bash(pnpm* outdated:*)",
      "Bash(pnpm* remove*)",
      "Bash(pnpm* run*)",
      "Bash(pnpm* start*)",
      "Bash(pnpm* typecheck*)",
      "Bash(pnpm* test*)",
      "Bash(pnpm* validate*)",
      "Bash(pnpm* view*)",
      "Bash(pnpm* why*)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(bat *)",
      "Bash(cat *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(for *)",
      "Bash(fzf *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(yq *)",
      "Bash(brew *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git status *)",
      "Bash(git worktree *)",
      "Bash(git diff-branch *)",
      "Bash(git diff-commit *)",
      "Bash(git diff-files *)",
      "Bash(git diff-index *)",
      "Bash(git diff-tag *)",
      "Bash(git diff-remote *)",
      "Bash(git diff-stash *)",
      "Bash(git diff-tree *)",
      "Bash(git diff-worktree *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh list *)",
      "Bash(gh pr *)",
      "Bash(gh release *)",
      "Bash(gh view *)",
      "Bash(docker *)",
      "Bash(linear issue *)",
      "Bash(defaults read *)",
      "mcp__expo-mcp__*",
      "mcp__plugin_figma_figma__*",
      "mcp__plugin_figma_figma-desktop__*",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:unpkg.com)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)",
      "mcp__ide__getDiagnostics"
    ],
    "ask": [
      "Bash(brew install *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5-1[1m]",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "PreCompact": [],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/patt/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "bashEditDiffEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'input=$(cat); model=$(echo \"$input\" | jq -r \".model.display_name\"); total_in=$(echo \"$input\" | jq -r \".context_window.total_input_tokens\"); total_out=$(echo \"$input\" | jq -r \".context_window.total_output_tokens\"); total=$((total_in + total_out)); if [ $total -ge 1000000 ]; then tokens=$(printf \"%.1fM\" $(echo \"scale=1; $total / 1000000\" | bc)); elif [ $total -ge 1000 ]; then tokens=$(printf \"%.1fK\" $(echo \"scale=1; $total / 1000\" | bc)); else tokens=\"$total\"; fi; usage=$(echo \"$input\" | jq \".context_window.current_usage\"); if [ \"$usage\" != \"null\" ]; then current=$(echo \"$usage\" | jq \".input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens\"); size=$(echo \"$input\" | jq \".context_window.context_window_size\"); pct=$((current * 100 / size)); context=\"${pct}%\"; else context=\"0%\"; fi; printf \"\\033[36m%s\\033[0m | \\033[33m%s tokens\\033[0m | \\033[35m%s context\\033[0m\" \"$model\" \"$tokens\" \"$context\"'"
  },
  "enabledPlugins": {
    "claude-notifications-go@claude-notifications-go": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "expo-app-design@expo-plugins": false,
    "figma@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "linear@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "superwhisper@superwhisper": false,
    "swift-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "understand-anything@understand-anything": false,
    "patt@pattobrien": true,
    "worktrunk@worktrunk": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "plannotator-effective-html@effective-html": true,
    "codex@openai-codex": true,
    "slack@claude-plugins-official": false,
    "langfuse-observability@langfuse-observability": true,
    "cloudflare@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "iso-24495-plain-language@iso-24495": true,
    "pstack@cursor-plugins": true,
    "show-me@skills": true
  },
  "extraKnownMarketplaces": {
    "claude-notifications-go": {
      "source": {
        "source": "github",
        "repo": "777genius/claude-notifications-go"
      }
    },
    "expo-plugins": {
      "source": {
        "source": "github",
        "repo": "expo/skills"
      }
    },
    "superwhisper": {
      "source": {
        "source": "github",
        "repo": "superultrainc/superwhisper-claude-code"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "pattobrien": {
      "source": {
        "source": "directory",
        "path": "/Users/patt/dev/pattobrien/shed"
      },
      "autoUpdate": true
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "effective-html": {
      "source": {
        "source": "github",
        "repo": "plannotator/effective-html"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "langfuse-observability": {
      "source": {
        "source": "github",
        "repo": "langfuse/Claude-Observability-Plugin"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "iso-24495": {
      "source": {
        "source": "git",
        "url": "https://github.com/GaZmagik/iso-24495.git"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/patt/dev/cursor/plugins"
      }
    },
    "skills": {
      "source": {
        "source": "github",
        "repo": "humanlayer/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "langfuse-observability@langfuse-observability": {
      "options": {
        "LANGFUSE_PUBLIC_KEY": "pk-lf-4b770f0f-f02c-483e-8d03-30458e273f44",
        "LANGFUSE_BASE_URL": "https://langfuse.garden.finedesigns.io",
        "LANGFUSE_USER_ID": "patt",
        "CC_LANGFUSE_DEBUG": true
      }
    }
  },
  "plansDirectory": "./docs/plans",
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(herdr pane:*)",
      "Bash(herdr agent read:*)",
      "Bash(vp:*)",
      "Bash(op read:*)",
      "Bash(op item list:*)"
    ]
  },
  "voiceEnabled": true
}
