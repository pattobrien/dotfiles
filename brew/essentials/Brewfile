# Shell
brew "zsh"
brew "powerlevel10k"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
# zsh plugin manager for the starship flavor (zsh/zshrc.starship)
brew "antidote"

# Essential CLI tools
brew "tree"
# Touch ID for sudo inside tmux (see scripts/setup_touchid_sudo.zsh)
brew "pam-reattach"
brew "wget"
brew "curl"

# gh is not in mise: mise reads its token to authenticate GitHub API calls
# (see zsh/zshrc), so it must exist before the first `mise install`.
brew "gh"
brew "mise"

# 1Password
cask "1password"
cask "1password-cli"

# Editor (pick one or both)
cask "cursor"
# cask "visual-studio-code"
cask "kitty@nightly"
cask "ghostty"


cask "google-chrome"
cask "raycast"

# Keyboard customizer (reads ~/.config/karabiner, symlinked by the base install)
cask "karabiner-elements"

# Hammerspoon + Hammerflow leader-key bindings (reads ~/.hammerspoon, symlinked
# by the base install; Karabiner maps Right Cmd -> F18 as the leader)
cask "hammerspoon"